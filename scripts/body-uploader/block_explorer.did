// Body-upload subset of the block_explorer interface used by body-uploader.
type PushBodyOk = record {
  height : nat;
  tx_count : nat;
  first_tx_index : nat;
  canonical_indexed : bool;
  duplicate : bool;
};
type PushBodyResult = variant { ok : PushBodyOk; err : text };
type BodyBatchResult = record {
  accepted : nat;
  duplicate : nat;
  last_error : opt text;
};
type BodyBatchResultR = variant { ok : BodyBatchResult; err : text };
service : {
  // Next canonical height whose body is still missing (contiguous frontier).
  bodies_next_height : () -> (nat) query;
  // For each big-endian display-hash, is the header for that block known?
  // Used by body-uploader to skip push_body(ies) calls (which cost cycles)
  // when the header relay hasn't reached the corresponding height yet.
  have_hashes : (hashes_be_hex : vec text) -> (vec bool) query;
  // Index one block's body: block hash (internal LE), txids (each a 32-byte
  // internal LE blob, in block order), raw coinbase bytes (segwit witness
  // stripped). Allowed for any known block whose body isn't known. The
  // canister:
  //   1. verifies coinbase_tx.size() > 64 (every internal merkle node is
  //      dSHA of exactly 64 bytes, so this pin forces txids[0] to be a
  //      real leaf-level tx — no attacker can supply bytes of any other
  //      length that dSHA to an internal-node value without a SHA-256
  //      preimage),
  //   2. recomputes dSHA(coinbase_tx) and checks it equals txids[0]
  //      (binds the uploaded coinbase to this body),
  //   3. recomputes the full Merkle root over txids and checks it against
  //      the block header's merkle_root.
  push_body : (blob, vec blob, blob) -> (PushBodyResult);
  // Batched variant; processes in order, stops at the first real error.
  push_bodies : (vec record { blob; vec blob; blob }) -> (BodyBatchResultR);
};
