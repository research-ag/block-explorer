type TxLocation = 
 record {
   dbidx: nat;
   position: nat;
 };
type Stats = 
 record {
   body_capacity_blocks: nat;
   indexed_txids: nat;
 };
type StableTrieStats = 
 record {
   byte_size: nat;
   leaf_count: nat;
   node_count: nat;
 };
type Result_1 = 
 variant {
   err: text;
   ok: BatchPutResult;
 };
type Result = 
 variant {
   err: text;
   ok: PutOk;
 };
type Response = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   status_code: nat16;
 };
type Request = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   method: text;
   url: text;
 };
type PutOk = 
 record {
   dbidx: nat;
   duplicate: bool;
   first_txdbidx: nat;
   tx_count: nat;
 };
type Body = 
 record {
   first_txdbidx: nat;
   tx_count: nat;
 };
type BatchPutResult = 
 record {
   accepted: nat;
   duplicate: nat;
   last_error: opt text;
 };
service : {
  body_region_byte_size: () -> (nat) query;
  cycles_balance: () -> (nat) query;
  get_body: (dbidx: nat) -> (opt Body) query;
  http_request: (req: Request) -> (Response) query;
  lookup_txdbidx: (txid: blob) -> (opt nat) query;
  lookup_txid: (txid: blob) -> (opt TxLocation) query;
  put_bodies: (batch: vec record {
                            blob;
                            nat;
                            blob;
                          }) -> (Result_1);
  put_body: (block_hash_internal: blob, tx_count: nat, hashes: blob) ->
   (Result);
  stats: () -> (Stats) query;
  tx_at: (dbidx: nat, position: nat) -> (opt blob) query;
  tx_count_of: (dbidx: nat) -> (opt nat) query;
  txid_of_txdbidx: (idx: nat) -> (opt blob) query;
  txid_trie_memory_stats: () -> (StableTrieStats) query;
}
